# ============================================
# GREEN JOBS BRASIL - Environment Variables
# ============================================
# Copie este arquivo para .env e preencha com seus valores
# Nunca commite o arquivo .env com credenciais reais!

# ============================================
# SERVIDOR
# ============================================
PORT=8002
HOST=127.0.0.1
DEBUG=true
RELOAD=true

# ============================================
# BANCO DE DADOS
# ============================================
# SQLite (Desenvolvimento)
DB_PATH=api/gjb_dev.db

# PostgreSQL (Produção)
# DATABASE_URL=postgresql://username:password@localhost:5432/gjb_db

# ============================================
# SEGURANÇA
# ============================================
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_STRONG_RANDOM_KEY
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440
BCRYPT_ROUNDS=12

# ============================================
# CORS
# ============================================
CORS_ORIGINS=http://localhost:3000,http://localhost:8002,http://127.0.0.1:8002
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOW_HEADERS=*

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_PER_SECOND=10
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_HOUR=1000

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_DIR=logs
LOG_FILE=greenjobs.log
LOG_MAX_SIZE_MB=10
LOG_BACKUP_COUNT=5

# ============================================
# STORAGE
# ============================================
UPLOAD_DIR=api/static/uploads
MAX_UPLOAD_SIZE_MB=5
ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf,doc,docx

# ============================================
# APIs EXTERNAS
# ============================================
RECEITA_API_URL=https://www.receitaws.com.br/v1
EXTERNAL_API_TIMEOUT=30
EXTERNAL_API_MAX_RETRIES=3

# ============================================
# ETL (Legado - manter para compatibilidade)
# ============================================
TARGET_UFS=MG,RJ,SP
RAW_DIR=data/raw
PROCESSED_DIR=data/processed
CHUNK_SIZE=10000
MAX_WORKERS=4
BACKUP_ENABLED=true
ARCHIVE_DAYS=30

# ============================================
# FEATURES FLAGS
# ============================================
ENABLE_REGISTRATION=true
ENABLE_ML_MATCHING=true
ENABLE_AUTO_IMPORT=false
ENABLE_TSB=true
ENABLE_STORYTELLING=true
MAINTENANCE_MODE=false

# ============================================
# AMBIENTE
# ============================================
ENVIRONMENT=development
APP_NAME=Green Jobs Brasil
APP_VERSION=1.6.0
BASE_URL=http://127.0.0.1:8002